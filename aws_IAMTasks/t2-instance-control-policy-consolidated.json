{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyT2Instances",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "ec2:InstanceType": "t2.*"
        }
      }
    },
    {
      "Sid": "AllowChangeFromT2ToAllowedTypes",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringLike": {
          "ec2:InstanceType": [
            "t3.*",
            "m5.*",
            "c5.*"
          ]
        }
      }
    }
  ]
}